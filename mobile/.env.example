# Copy this file to `.env` (untracked) and adjust for your environment.
# Every variable exposed to the app MUST be prefixed EXPO_PUBLIC_ per Expo's
# convention (https://docs.expo.dev/guides/environment-variables/) — anything
# with that prefix is bundled into the client, so never put a secret here.
# There is no OpenAI key or other credential in this app: all AI-backed
# features call your own backend, which holds real credentials server-side.

# Base URL of your backend. Leave unset (or blank) to run fully in mock mode,
# which is the default and requires no backend at all.
EXPO_PUBLIC_BACKEND_BASE_URL=

# "true" (default when unset) forces mock responses even if a backend URL is
# configured above. Set to "false" once a real backend is ready to test
# against. Mock mode never makes a network call.
EXPO_PUBLIC_MOCK_MODE=true
